generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String     @id
  name        String
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  employees   Employee[]

  @@map("roles")
}

model Employee {
  id        String    @id
  role      String    @map("role_id")
  fullName  String    @map("full_name")
  password  String
  mustChangePassword Boolean @default(false) @map("must_change_password")
  createdAt DateTime  @default(now()) @map("created_at")

  roleRecord            Role                   @relation(fields: [role], references: [id])
  projects              Project[]
  whatsNews             WhatsNew[]
  confirmedPayments     Payment[]              @relation("PaymentConfirmedBy")
  archivedProjects      ArchivedProject[]
  archivedWhatsNews     ArchivedWhatsNew[]
  archivedProducts      ArchivedProduct[]
  passwordResetRequests PasswordResetRequest[] @relation("EmployeePasswordResetRequests")
  approvedResetRequests PasswordResetRequest[] @relation("ApprovedByEmployee")

  @@map("employees")
}

model User {
  id               String               @id @default(cuid())
  email            String               @unique
  password         String
  fullName         String               @map("full_name")
  hasLocalPassword Boolean              @default(true) @map("has_local_password")
  createdAt        DateTime             @default(now()) @map("created_at")

  orders           Order[]
  reviews          NewsReview[]
  resetTokens      PasswordResetToken[]
  passwordResetRequests PasswordResetRequest[] @relation("UserPasswordResetRequests")
  customerContacts CustomerContact[]
  consultations    Consultation[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

model PasswordResetRequest {
  id           String    @id @default(cuid())
  accountType  String    @map("account_type")
  status       String    @default("pending")
  tokenHash    String?   @unique @map("token_hash")
  expiresAt    DateTime? @map("expires_at")
  usedAt       DateTime? @map("used_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  approvedAt   DateTime? @map("approved_at")
  rejectedAt   DateTime? @map("rejected_at")
  userId       String?   @map("user_id")
  employeeId   String?   @map("employee_id")
  approvedById String?   @map("approved_by")

  user       User?     @relation("UserPasswordResetRequests", fields: [userId], references: [id])
  employee   Employee? @relation("EmployeePasswordResetRequests", fields: [employeeId], references: [id])
  approvedBy Employee? @relation("ApprovedByEmployee", fields: [approvedById], references: [id])

  @@index([status, createdAt])
  @@index([userId])
  @@index([employeeId])
  @@index([approvedById])
  @@map("password_reset_requests")
}

model ProductCategory {
  id           String    @id @default(cuid())
  categoryName String    @map("category_name")
  description  String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  products Product[]
  archivedProducts ArchivedProduct[]

  @@map("product_categories")
}

model Product {
  id              String    @id
  categoryId      String    @map("category_id")
  namaProduk      String    @map("nama_produk")
  hargaProduk     String    @map("harga_produk")
  deskripsiProduk String    @map("deskripsi_produk")
  durasiProduk    String    @map("durasi_produk")
  terjual         String
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  category         ProductCategory   @relation(fields: [categoryId], references: [id])
  orders           Order[]
  archivedProducts ArchivedProduct[]

  @@map("products")
}

model Order {
  id            String    @id @map("order_id")
  userId        String    @map("user_id")
  productId     String    @map("product_id")
  totalPesanan  String    @map("total_pesanan")
  namaCustomer  String    @map("nama_customer")
  statusPesanan String    @map("status_pesanan")
  createdAt     DateTime  @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  payment Payment?

  @@map("orders")
}

model Payment {
  id               String    @id @default(cuid())
  orderId          String    @unique @map("order_id")
  confirmedBy      String    @map("confirmed_by")
  jenisPembayaran  String    @map("jenis_pembayaran")
  buktiPembayaran  String    @map("bukti_pembayaran")
  statusPembayaran String    @map("status_pembayaran")
  paidAt           DateTime? @map("paid_at")
  confirmedAt      DateTime? @map("confirmed_at")

  order              Order    @relation(fields: [orderId], references: [id])
  confirmedByEmployee Employee @relation("PaymentConfirmedBy", fields: [confirmedBy], references: [id])

  @@map("payments")
}

model NewsStory {
  id               String       @id @default(cuid())
  title            String
  category         String
  authorName       String       @map("author_name")
  imageUrl         String?      @map("image_url")
  documentUrl      String?      @map("document_url")
  contentText      String?      @db.LongText @map("content_text")
  summaryPart1     String?      @db.LongText @map("summary_part_1")
  summaryPart2     String?      @db.LongText @map("summary_part_2")
  summaryPart3     String?      @db.LongText @map("summary_part_3")
  customerName     String?      @map("customer_name")
  customerIndustry String?      @map("customer_industry")
  customerSize     String?      @map("customer_size")
  customerLocation String?      @map("customer_location")
  customerProducts String?      @db.LongText @map("customer_products")
  viewCount        Int          @default(0) @map("view_count")
  commentCount     Int          @default(0) @map("comment_count")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")

  reviews          NewsReview[]
  views            NewsView[]

  @@map("news_stories")
}

model NewsReview {
  id          String    @id @default(cuid())
  newsStoryId String    @map("news_story_id")
  userId      String    @map("user_id")
  rating      Int
  comment     String    @db.LongText
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  newsStory NewsStory @relation(fields: [newsStoryId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@map("news_reviews")
}

model NewsView {
  id          String   @id @default(cuid())
  newsStoryId String   @map("news_story_id")
  createdAt   DateTime @default(now()) @map("created_at")

  newsStory NewsStory @relation(fields: [newsStoryId], references: [id])

  @@map("news_views")
}

model Project {
  id          String   @id
  employeeId  String   @map("employee_id")
  startLabel  String   @map("start_label")
  targetLabel String   @map("target_label")
  status      String
  createdAt   DateTime @default(now()) @map("created_at")

  employee         Employee          @relation(fields: [employeeId], references: [id])
  archivedProjects ArchivedProject[]

  @@map("projects")
}

model WhatsNew {
  id           String   @id @default(cuid())
  employeeId   String   @map("employee_id")
  title        String
  category     String
  summary      String   @db.LongText
  contentText  String?  @db.LongText @map("content_text")
  imageUrl     String?  @map("image_url")
  isHighlight  Boolean  @default(false) @map("is_highlight")
  publishDate  DateTime @map("publish_date")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employee         Employee           @relation(fields: [employeeId], references: [id])
  archivedWhatsNew ArchivedWhatsNew[]

  @@map("whats_new")
}

model CustomerContact {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  fullName      String   @map("full_name")
  phoneCode     String   @map("phone_code")
  phoneNumber   String   @map("phone_number")
  companyName   String   @map("company_name")
  industry      String   @map("industry")
  industryOther String?  @map("industry_other")
  companyEmail  String   @map("company_email")
  companyScale  String   @map("company_scale")
  message       String   @db.LongText
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("customer_contacts")
}

model Consultation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  email     String
  phone     String
  company   String?
  product   String
  message   String   @db.LongText
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("consultations")
}

model ArchivedProduct {
  id              String   @id @default(cuid())
  originalId      String   @map("original_id")
  categoryId      String   @map("category_id")
  namaProduk      String   @map("nama_produk")
  hargaProduk     String   @map("harga_produk")
  deskripsiProduk String   @map("deskripsi_produk")
  durasiProduk    String   @map("durasi_produk")
  terjual         String
  deletedAt       DateTime @default(now()) @map("deleted_at")
  deletedBy       String?  @map("deleted_by")

  product   Product         @relation(fields: [originalId], references: [id])
  category  ProductCategory @relation(fields: [categoryId], references: [id])
  employee  Employee?       @relation(fields: [deletedBy], references: [id])

  @@map("archived_products")
}

model ArchivedProject {
  id          String   @id @default(cuid())
  originalId  String   @map("original_id")
  employeeId  String   @map("employee_id")
  startLabel  String   @map("start_label")
  targetLabel String   @map("target_label")
  status      String
  createdAt   DateTime @map("created_at")
  deletedAt   DateTime @default(now()) @map("deleted_at")
  deletedBy   String?  @map("deleted_by")

  project  Project  @relation(fields: [originalId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("archived_projects")
}

model ArchivedWhatsNew {
  id           String   @id @default(cuid())
  originalId   String   @map("original_id")
  employeeId   String   @map("employee_id")
  title        String
  category     String
  summary      String   @db.LongText
  contentText  String?  @db.LongText @map("content_text")
  imageUrl     String?  @map("image_url")
  isHighlight  Boolean  @map("is_highlight")
  publishDate  DateTime @map("publish_date")
  createdAt    DateTime @map("created_at")
  updatedAt    DateTime @map("updated_at")
  deletedAt    DateTime @default(now()) @map("deleted_at")
  deletedBy    String?  @map("deleted_by")

  whatsNew WhatsNew @relation(fields: [originalId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("archived_whats_new")
}
