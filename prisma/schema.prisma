generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Test {
  id Int @id @default(autoincrement())

  @@map("test")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  fullName  String
  hasLocalPassword Boolean @default(true) @map("has_local_password")
  createdAt DateTime @default(now())
  orders    Order[]
  reviews   Review[]
  resetTokens PasswordResetToken[]

  @@map("user")
}

model Employee {
  id        String   @id
  fullName  String
  password  String
  role      EmployeeRole @default(STAFF)
  createdAt DateTime @default(now())

  @@map("employee")
}

enum EmployeeRole {
  ADMIN
  MARKETING
  PROJECT_MANAGEMENT
  STAFF
}

model Project {
  id          String   @id
  startLabel  String
  targetLabel String
  owner       String
  status      String
  createdAt   DateTime @default(now())

  @@map("project")
}

model BigAssistant {
  id              String @id
  namaProduk      String @map("nama_produk")
  hargaProduk     String @map("harga_produk")
  deskripsiProduk String @map("deskripsi_produk")
  durasiProduk    String @map("durasi_produk")
  terjual         String

  @@map("big_assistant")
}

model BigVision {
  id              String @id
  namaProduk      String @map("nama_produk")
  hargaProduk     String @map("harga_produk")
  deskripsiProduk String @map("deskripsi_produk")
  durasiProduk    String @map("durasi_produk")
  terjual         String

  @@map("big_vision")
}

model BigLegal {
  id              String @id
  namaProduk      String @map("nama_produk")
  hargaProduk     String @map("harga_produk")
  deskripsiProduk String @map("deskripsi_produk")
  durasiProduk    String @map("durasi_produk")
  terjual         String

  @@map("big_legal")
}

model BigSocial {
  id              String @id
  namaProduk      String @map("nama_produk")
  hargaProduk     String @map("harga_produk")
  deskripsiProduk String @map("deskripsi_produk")
  durasiProduk    String @map("durasi_produk")
  terjual         String

  @@map("big_social")
}

enum ProductType {
  BIG_ASSISTANT
  BIG_LEGAL
  BIG_SOCIAL
  BIG_VISION
}

model Order {
  id            String      @id @map("order_id")
  productType   ProductType @map("product_type")
  productId     String      @map("product_id")
  totalPesanan  String      @map("total_pesanan")
  namaCustomer  String      @map("nama_customer")
  statusPesanan String      @map("status_pesanan")
  jenisPembayaran String    @map("jenis_pembayaran")
  buktiPembayaran String    @map("bukti_pembayaran")
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("orders")
}

model CustomerContact {
  id            String   @id @default(cuid())
  fullName      String   @map("full_name")
  phoneCode     String   @map("phone_code")
  phoneNumber   String   @map("phone_number")
  companyName   String   @map("company_name")
  industry      String   @map("industry")
  industryOther String?  @map("industry_other")
  companyEmail  String   @map("company_email")
  companyScale  String   @map("company_scale")
  message       String   @map("message")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("customer_contacts")
}

model Consultation {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  company   String?
  product   String   // BigAI atau BigVision
  message   String   @db.LongText
  createdAt DateTime @default(now())

  @@map("consultation")
}

model NewsStory {
  id               String   @id @default(cuid())
  title            String
  category         String
  authorName       String   @map("author_name")
  imageUrl         String?  @map("image_url")
  documentUrl      String?  @map("document_url")
  contentText      String?  @db.LongText @map("content_text")
  summaryPart1     String?  @db.LongText @map("summary_part_1")
  summaryPart2     String?  @db.LongText @map("summary_part_2")
  summaryPart3     String?  @db.LongText @map("summary_part_3")
  customerName     String?  @map("customer_name")
  customerIndustry String?  @map("customer_industry")
  customerSize     String?  @map("customer_size")
  customerLocation String?  @map("customer_location")
  customerProducts String?  @db.LongText @map("customer_products")
  viewCount        Int      @default(0) @map("view_count")
  commentCount     Int      @default(0) @map("comment_count")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  reviews          Review[]
  views            NewsView[]

  @@map("news_stories")
}

model Review {
  id          String   @id @default(cuid())
  newsStoryId String   @map("news_story_id")
  userId      String   @map("user_id")
  rating      Int
  comment     String   @db.LongText
  createdAt   DateTime @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  newsStory NewsStory @relation(fields: [newsStoryId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@map("news_reviews")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

model NewsView {
  id          String   @id @default(cuid())
  newsStoryId String   @map("news_story_id")
  createdAt   DateTime @default(now()) @map("created_at")

  newsStory NewsStory @relation(fields: [newsStoryId], references: [id])

  @@map("news_views")
}

model WhatsNew {
  id           String   @id @default(cuid())
  title        String
  category     String
  summary      String   @db.LongText
  contentText  String?  @db.LongText @map("content_text")
  imageUrl     String?  @map("image_url")
  isHighlight  Boolean  @default(false) @map("is_highlight")
  publishDate  DateTime @map("publish_date")
  authorName   String   @map("author_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("whats_new")
}

model ArchivedProduct {
  id              String      @id @default(cuid())
  originalId      String      @map("original_id")
  productType     ProductType @map("product_type")
  namaProduk      String      @map("nama_produk")
  hargaProduk     String      @map("harga_produk")
  deskripsiProduk String      @map("deskripsi_produk")
  durasiProduk    String      @map("durasi_produk")
  terjual         String
  deletedAt       DateTime    @default(now()) @map("deleted_at")
  deletedBy       String?     @map("deleted_by")

  @@map("archived_products")
}

model ArchivedProject {
  id          String   @id @default(cuid())
  originalId  String   @map("original_id")
  startLabel  String   @map("start_label")
  targetLabel String   @map("target_label")
  owner       String
  status      String
  createdAt   DateTime @map("created_at")
  deletedAt   DateTime @default(now()) @map("deleted_at")
  deletedBy   String?  @map("deleted_by")

  @@map("archived_projects")
}

model ArchivedWhatsNew {
  id           String   @id @default(cuid())
  originalId   String   @map("original_id")
  title        String
  category     String
  summary      String   @db.LongText
  contentText  String?  @db.LongText @map("content_text")
  imageUrl     String?  @map("image_url")
  isHighlight  Boolean  @map("is_highlight")
  publishDate  DateTime @map("publish_date")
  authorName   String   @map("author_name")
  createdAt    DateTime @map("created_at")
  updatedAt    DateTime @map("updated_at")
  deletedAt    DateTime @default(now()) @map("deleted_at")
  deletedBy    String?  @map("deleted_by")

  @@map("archived_whats_new")
}
